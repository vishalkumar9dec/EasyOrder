{
	admin off
}

:80 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Same-origin API routing: the frontend's fetch() calls are all relative
	# (/api/...), so this is the only thing that makes the static PWA build
	# work in production at all — Vite's dev-server proxy does not exist here.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Content-hashed build output: the filename changes whenever the bytes do,
	# so this can be cached indefinitely.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# The app shell and the service worker script keep their names across
	# deploys, so a cached copy of either pins the whole app to an old build:
	# the SW goes on serving a stale index.html, that bundle requests asset
	# hashes the server no longer has, and the result is an old UI with broken
	# images while the correct files sit right there. Always revalidate.
	@shell path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @shell Cache-Control "no-cache, max-age=0, must-revalidate"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
