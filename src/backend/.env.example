APP_NAME=EasyOrder
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

BACKEND_CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://easyorder:easyorder@localhost:5432/easyorder
# memory (default) | postgres — postgres persists sessions, timeline
# events, and short links across restarts (make db-up && make db-migrate)
PERSISTENCE_MODE=memory
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_PROVIDER_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v20.0
# Approved handoff template; leave empty to use the interactive CTA message
WHATSAPP_HANDOFF_TEMPLATE_NAME=
WHATSAPP_HANDOFF_TEMPLATE_LANGUAGE=en
# Route untagged direct messages to the business number by intent
WHATSAPP_BUSINESS_CHAT_ENABLED=true

SWIGGY_CLIENT_MODE=mock
# mode=mcp connects to a real MCP server over HTTP, e.g. the local
# mock-swiggy-mcp service: `cd services/mock-swiggy-mcp && python app/server.py`
SWIGGY_MCP_SERVER_URL=http://localhost:9100/mcp
SWIGGY_MCP_AUTH_TOKEN=

# LLM_MODE=mock keeps the deterministic regex parser (no API key needed).
# LLM_MODE=openai uses OPENAI_API_KEY for real intent parsing + tool calling.
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# "text" is readable for local dev; use "json" in any hosted environment
LOG_LEVEL=INFO
LOG_FORMAT=text
# Sentry error tracking; leave empty to disable (no-op)
SENTRY_DSN=
