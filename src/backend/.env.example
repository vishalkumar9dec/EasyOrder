APP_NAME=EasyOrder
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

BACKEND_CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://easyorder:easyorder@localhost:5432/easyorder
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_PROVIDER_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v20.0
# Approved handoff template; leave empty to use the interactive CTA message
WHATSAPP_HANDOFF_TEMPLATE_NAME=
WHATSAPP_HANDOFF_TEMPLATE_LANGUAGE=en
# Route untagged direct messages to the business number by intent
WHATSAPP_BUSINESS_CHAT_ENABLED=true

SWIGGY_CLIENT_MODE=mock
SWIGGY_MCP_SERVER_PATH=
SWIGGY_MCP_SERVER_ENV={}

LLM_MODE=mock
